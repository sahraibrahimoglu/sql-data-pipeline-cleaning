-- ==========================================================
-- Project: Customer Data Cleansing Pipeline
-- Description: This script standardizes raw customer data 
--              (fixes text casing, handles nulls, parses dates, 
--              and removes duplicates).
-- Table Name: clean_customers
-- ==========================================================
CREATE TABLE raw_customers (
  id INT,
  name STRING,
  email STRING,
  age STRING,
  country STRING,
  signup_date STRING
);
